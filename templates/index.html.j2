<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>MediaWG Dashboard</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; }
  header { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1px solid #ccc; padding-bottom: 0.5rem; margin-bottom: 1rem; }
  h1 { margin: 0; font-size: 1.5rem; }
  .meta { color: #666; font-size: 0.85rem; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid #e0e0e0; }
  th { font-weight: 600; cursor: pointer; user-select: none; background: #f6f6f6; position: sticky; top: 0; }
  th:hover { background: #ececec; }
  tbody tr:hover { background: #fafafa; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  td.stage { font-weight: 600; }
  td.age-warn { color: #c00; }
  a { color: #0366d6; text-decoration: none; }
  a:hover { text-decoration: underline; }
  footer { margin-top: 2rem; color: #888; font-size: 0.8rem; }
  @media (prefers-color-scheme: dark) {
    body { background: #111; color: #eee; }
    th { background: #1a1a1a; }
    th:hover { background: #222; }
    tbody tr:hover { background: #181818; }
    th, td { border-bottom-color: #2a2a2a; }
    .meta, footer { color: #888; }
    a { color: #58a6ff; }
  }
</style>
</head>
<body>
<header>
  <h1>MediaWG Dashboard</h1>
  <span class="meta">Refreshed {{ refreshed_at }}</span>
</header>

<table id="specs">
<thead>
<tr>
  <th data-sort="title">Spec</th>
  <th data-sort="stage">Stage</th>
  <th data-sort="last">Last TR</th>
  <th data-sort="issues" class="num">Open issues</th>
  <th data-sort="prs" class="num">Open PRs</th>
  <th data-sort="age" class="num">Oldest issue (days)</th>
  <th>Repo</th>
</tr>
</thead>
<tbody>
{% for spec in specs %}
<tr>
  <td>{% if spec.status.ed_url %}<a href="{{ spec.status.ed_url }}">{{ spec.meta.title }}</a>{% else %}{{ spec.meta.title }}{% endif %}</td>
  <td class="stage">{{ spec.status.stage }}</td>
  <td>{{ spec.status.last_tr_publication or "—" }}</td>
  <td class="num">{{ spec.stats.open_issues_count }}</td>
  <td class="num">{{ spec.stats.open_prs_count }}</td>
  <td class="num{% if spec.stats.oldest_open_issue_age_days and spec.stats.oldest_open_issue_age_days > 365 %} age-warn{% endif %}">{{ spec.stats.oldest_open_issue_age_days if spec.stats.oldest_open_issue_age_days is not none else "—" }}</td>
  <td><a href="https://github.com/{{ spec.meta.repo }}">{{ spec.meta.repo }}</a>{% if spec.meta.tr_url %} · <a href="{{ spec.meta.tr_url }}">TR</a>{% endif %}</td>
</tr>
{% else %}
<tr><td colspan="7" style="text-align:center; color:#888;">No specs configured.</td></tr>
{% endfor %}
</tbody>
</table>

<footer>
  Read-only summary of public data from <a href="https://api.w3.org/">api.w3.org</a> and <a href="https://api.github.com/">api.github.com</a>.
  Source: <a href="https://github.com/alastor0325/mediawg-dashboard">alastor0325/mediawg-dashboard</a>.
</footer>

<script>
(function() {
  const table = document.getElementById("specs");
  if (!table) return;
  const tbody = table.querySelector("tbody");
  table.querySelectorAll("th[data-sort]").forEach((th, idx) => {
    let asc = true;
    th.addEventListener("click", () => {
      const rows = Array.from(tbody.querySelectorAll("tr"));
      rows.sort((a, b) => {
        const av = a.cells[idx].textContent.trim();
        const bv = b.cells[idx].textContent.trim();
        const an = parseFloat(av);
        const bn = parseFloat(bv);
        if (!isNaN(an) && !isNaN(bn)) return asc ? an - bn : bn - an;
        return asc ? av.localeCompare(bv) : bv.localeCompare(av);
      });
      rows.forEach(r => tbody.appendChild(r));
      asc = !asc;
    });
  });
})();
</script>
</body>
</html>
