<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MediaWG · Ledger</title>
<link rel="icon" type="image/svg+xml" href="favicon.svg">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,400,50;9..144,500,50;9..144,700,30;9..144,900,0&family=Plus+Jakarta+Sans:wght@200..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  :root {
    color-scheme: light dark;
    --paper:        #f8f5ec;
    --paper-warm:   #f1ece0;
    --ink:          #14130e;
    --ink-soft:     #2a261e;
    --muted:        #5a5650;
    --rule:         #d0c9b6;
    --rule-strong:  #a89f8a;
    --accent:       #a83a08;
    --accent-soft:  #c46436;
    --signal-green: #3e5e1e;
    --signal-blue:  #2e4d7e;
    --signal-amber: #7a5400;
    --signal-rose:  #8a1f30;
    --signal-mute:  #6a655c;
    --grain-light:  rgba(20,19,14,0.010);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper:        #0e0d0a;
      --paper-warm:   #15140f;
      --ink:          #f1ecdf;
      --ink-soft:     #d6d0bc;
      --muted:        #9c9686;
      --rule:         #2e2b25;
      --rule-strong:  #4a463c;
      --accent:       #e88044;
      --accent-soft:  #b86840;
      --signal-green: #a2b878;
      --signal-blue:  #88aedd;
      --signal-amber: #e0b864;
      --signal-rose:  #dc8898;
      --signal-mute:  #807a6c;
      --grain-light:  rgba(241,236,223,0.015);
    }
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }

  body {
    background: var(--paper);
    background-image:
      radial-gradient(var(--grain-light) 1px, transparent 1px),
      radial-gradient(var(--grain-light) 1px, transparent 1px);
    background-size: 4px 4px, 7px 7px;
    background-position: 0 0, 1px 2px;
    color: var(--ink);
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 15px;
    font-weight: 450;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .frame {
    max-width: 1240px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  /* ============ Masthead ============ */
  .masthead {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: 0;
    position: relative;
  }
  .masthead::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -4px;
    height: 1px;
    background: var(--rule-strong);
  }

  .wordmark {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }
  .wordmark .accent { color: var(--accent); }

  h1.title {
    font-family: "Fraunces", Georgia, serif;
    font-variation-settings: "opsz" 144, "SOFT" 30;
    font-weight: 700;
    font-size: clamp(2.8rem, 6vw, 4.4rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }
  h1.title em {
    font-style: italic;
    font-variation-settings: "opsz" 144, "SOFT" 50;
    color: var(--accent);
  }

  .colophon {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.74rem;
    font-weight: 500;
    text-align: right;
    color: var(--ink-soft);
    line-height: 1.65;
  }
  .colophon .label {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted);
    font-weight: 600;
    display: block;
    margin-bottom: 0.2rem;
  }
  .colophon .ts {
    font-size: 0.88rem;
    color: var(--ink);
    font-weight: 600;
  }

  /* ============ Summary strip ============ */
  .summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 2.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .stat {
    padding: 1.1rem 0 1.2rem;
    border-right: 1px solid var(--rule);
    padding-right: 1.5rem;
  }
  .stat:last-child { border-right: none; }
  .stat + .stat { padding-left: 1.5rem; }
  .stat-num {
    font-family: "Fraunces", Georgia, serif;
    font-variation-settings: "opsz" 96, "SOFT" 30;
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .stat-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--ink-soft);
    margin-top: 0.55rem;
  }
  .stat-extra {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--ink);
    margin-top: 0.35rem;
  }
  .stat-extra .pip {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--signal-mute);
    margin-right: 0.35rem;
    vertical-align: 1px;
  }
  .stat-extra .stage-WD .pip,
  .stat-extra .stage-FPWD .pip { background: var(--signal-amber); }
  .stat-extra .stage-CR .pip,
  .stat-extra .stage-CR-snapshot .pip,
  .stat-extra .stage-CR-draft .pip { background: var(--signal-blue); }
  .stat-extra .stage-REC .pip,
  .stat-extra .stage-PR .pip { background: var(--signal-green); }
  .stat-extra .stage-ED .pip { background: var(--signal-mute); }
  .stat-extra .stage-Discontinued .pip { background: var(--signal-rose); }

  /* ============ Section head ============ */
  .section-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2.5rem 0 1rem;
  }
  .section-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .section-rule { flex: 1; height: 1px; background: var(--rule); }
  .section-meta {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    color: var(--muted);
  }

  /* ============ The Ledger Table ============ */
  table.ledger {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
  }
  .ledger thead th {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ink-soft);
    text-align: left;
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid var(--rule-strong);
    cursor: pointer;
    user-select: none;
    background: transparent;
    white-space: nowrap;
  }
  .ledger thead th:hover { color: var(--ink); }
  .ledger thead th .sort-glyph {
    color: var(--rule-strong);
    margin-left: 0.3rem;
    font-size: 0.7em;
  }
  .ledger thead th.num,
  .ledger tbody td.num { text-align: right; }
  .ledger thead th.center,
  .ledger tbody td.center { text-align: center; }

  .ledger tbody tr {
    border-bottom: 1px dotted var(--rule);
    transition: background-color 120ms ease;
  }
  .ledger tbody tr:hover {
    background: var(--paper-warm);
  }
  .ledger tbody td {
    padding: 1.05rem 0.85rem;
    vertical-align: middle;
  }

  /* Row number */
  td.rownum {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    color: var(--muted);
    width: 1ch;
    padding-right: 0.4rem;
  }

  /* Spec title cell */
  td.spec {
    line-height: 1.25;
    min-width: 14rem;
  }
  .spec-title {
    font-family: "Fraunces", Georgia, serif;
    font-variation-settings: "opsz" 36, "SOFT" 30;
    font-size: 1.22rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--ink);
    text-decoration: none;
    display: inline-block;
  }
  .spec-title:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .spec-sub {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--muted);
    margin-top: 0.3rem;
    letter-spacing: 0.02em;
  }

  /* Stage as typographic mark */
  .stage {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: help;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    border-bottom: 1px dotted var(--rule-strong);
    padding-bottom: 2px;
  }
  .stage::before {
    content: "";
    display: inline-block;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--signal-mute);
    flex: none;
  }
  .stage.WD::before, .stage.FPWD::before { background: var(--signal-amber); }
  .stage.CR::before,
  .stage.CR-snapshot::before,
  .stage.CR-draft::before { background: var(--signal-blue); }
  .stage.REC::before, .stage.PR::before { background: var(--signal-green); }
  .stage.ED::before, .stage.NOTE::before { background: var(--signal-mute); }
  .stage.Discontinued::before { background: var(--signal-rose); }

  /* Shared status-dot primitive (next-gate + pulse read as colored dots;
     interop keeps its ●◐○ glyph string so the two vocabularies never clash) */
  .hdot {
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--signal-mute);
    flex: none;
    vertical-align: 0;
  }

  /* Next-gate mark */
  td.gate {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .gate-name { color: var(--ink); font-weight: 600; letter-spacing: 0.04em; }
  .gate-dot { margin-left: 0.45rem; }
  .gate-dot.ready { background: var(--signal-green); }
  .gate-dot.blocked { background: var(--accent); }
  .gate-dot.unknown { background: var(--signal-mute); }

  /* Interop tri-dot + all-engines WPT */
  td.interop {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.9rem;
    white-space: nowrap;
    letter-spacing: 0.06em;
  }
  .interop-dots { color: var(--ink); }
  .interop-pct {
    color: var(--muted);
    margin-left: 0.5rem;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  /* Pulse */
  td.pulse {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .pulse-dot { margin-right: 0.4rem; }
  .pulse-on-track .pulse-dot { background: var(--signal-green); }
  .pulse-watch .pulse-dot { background: var(--signal-amber); }
  .pulse-at-risk .pulse-dot { background: var(--signal-rose); }
  .pulse-reason { color: var(--muted); }

  /* Expand affordance + detail panel */
  tr.spec-row { cursor: pointer; }
  .caret {
    display: inline-block;
    color: var(--rule-strong);
    font-size: 0.7em;
    margin-right: 0.35rem;
    transition: transform 140ms ease;
  }
  tr.spec-row.open .caret { transform: rotate(90deg); color: var(--accent); }
  tr.panel-row { animation: none !important; }
  tr.panel-row:hover { background: transparent; }
  tr.panel-row > td { padding: 0 0.85rem 1.4rem; border-bottom: 1px solid var(--rule); }
  .panel {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem 2.5rem;
    background: var(--paper-warm);
    border: 1px solid var(--rule);
    padding: 1.3rem 1.5rem;
  }
  .panel-h {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    margin-bottom: 0.7rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule);
  }
  /* Aligned key/value grid — labels and values line up in two columns
     (reads cleanly both in the 3-up wide view and stacked narrow view). */
  dl.panel-kv {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 1rem;
    row-gap: 0.32rem;
    margin: 0 0 0.5rem;
  }
  .panel-kv dt {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .panel-kv dd {
    margin: 0;
    font-size: 0.82rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .panel-kv dd a,
  ul.checklist a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px dotted var(--rule-strong);
  }
  .panel-kv dd a:hover,
  ul.checklist a:hover { color: var(--accent); border-color: var(--accent); }
  .panel-sub {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.64rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--muted);
    margin: 0.55rem 0 0.35rem;
  }
  ul.checklist { list-style: none; margin: 0 0 0.3rem; padding: 0; }
  ul.checklist li { font-size: 0.8rem; padding: 0.12rem 0; color: var(--ink); }
  ul.checklist .chk-mark { display: inline-block; width: 1.3em; color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .chip {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    padding: 0.12rem 0.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); }
  .chip-open { color: var(--signal-rose); }
  .chip-requested { color: var(--signal-amber); }
  .chip-resolved { color: var(--signal-green); }
  .chip-unknown, .chip-na { color: var(--muted); }
  .tag { font-family: "IBM Plex Mono", monospace; font-size: 0.68rem; font-weight: 600; }
  .tag-ready, .tag-pulse-on-track { color: var(--signal-green); }
  .tag-blocked, .tag-warn { color: var(--accent); }
  .tag-pulse-at-risk { color: var(--signal-rose); }
  .tag-pulse-watch { color: var(--signal-amber); }
  .tag-unknown { color: var(--muted); }
  @media (max-width: 900px) {
    /* Specificity must beat `.ledger tbody tr { display: grid }` below. */
    .ledger tbody tr.panel-row { display: block; }
    .ledger tbody tr.panel-row > td { display: block; padding: 0 0 1rem; }
    .panel { grid-template-columns: 1fr; gap: 1rem; }
  }

  .dash { color: var(--rule-strong); }

  /* Row entry animation */
  @keyframes row-enter {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .ledger tbody tr {
    animation: row-enter 420ms cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
  }
  {% for i in range(rows|length) %}
  .ledger tbody tr:nth-child({{ i + 1 }}) {
    animation-delay: {{ 40 + i * 30 }}ms;
  }
  {% endfor %}

  /* Footer */
  footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    color: var(--muted);
    line-height: 1.7;
  }
  footer p { margin: 0 0 0.3rem; }
  footer a { color: var(--ink-soft); border-bottom: 1px dotted var(--rule-strong); text-decoration: none; }
  footer a:hover { color: var(--accent); border-color: var(--accent); }
  footer .legend {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 0.8rem;
  }
  footer .legend .item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  footer .legend .pip {
    display: inline-block;
    width: 7px; height: 7px;
    border-radius: 50%;
  }
  .pip.green { background: var(--signal-green); }
  .pip.blue { background: var(--signal-blue); }
  .pip.amber { background: var(--signal-amber); }
  .pip.mute { background: var(--signal-mute); }
  .pip.rose { background: var(--signal-rose); }

  /* ============ Responsive ============ */

  /* Tier: laptop / small desktop — tighten paddings */
  @media (max-width: 1100px) {
    .frame { padding: 2.5rem 1.5rem 3rem; }
    table.ledger { font-size: 0.88rem; }
    .ledger thead th, .ledger tbody td { padding-left: 0.6rem; padding-right: 0.6rem; }
    .spec-title { font-size: 1.1rem; }
    td.spec { min-width: 12rem; }
  }

  /* Tier: tablet portrait & phone — the ledger doesn't fit; stack
     rows as labeled cards. Summary collapses to 2 cols. */
  @media (max-width: 900px) {
    .frame { padding: 2rem 1.25rem 2.5rem; }
    .summary { grid-template-columns: repeat(2, 1fr); }
    .stat {
      border-right: none;
      border-bottom: 1px dotted var(--rule);
      padding: 0.9rem 1rem;
    }
    .stat + .stat { padding-left: 1rem; }
    .stat:nth-child(odd) { border-right: 1px dotted var(--rule); }
    .stat:nth-last-child(-n+2) { border-bottom: none; }
    .stat-num { font-size: 2rem; }
    .section-head { flex-wrap: wrap; gap: 0.5rem; }
    .section-meta { font-size: 0.66rem; }

    /* Table → card layout */
    table.ledger { border-collapse: separate; }
    .ledger thead { display: none; }
    .ledger tbody { display: block; }
    .ledger tbody tr {
      display: grid;
      /* col 1: rownum · col 2: title · col 3: stage */
      grid-template-columns: 2.2rem minmax(0, 1fr) auto;
      column-gap: 0.85rem;
      row-gap: 0.65rem;
      padding: 1.4rem 0;
      border-bottom: 1px solid var(--rule);
      align-items: baseline;
    }
    .ledger tbody td {
      padding: 0;
      border: none;
      font-size: 0.98rem;
      min-width: 0;
    }
    /* Title row: rownum in its own column, title in the next, stage on right */
    td.rownum {
      grid-column: 1;
      grid-row: 1;
      width: auto;
      font-size: 0.7rem;
      align-self: start;
      padding-top: 0.55rem;
      text-align: right;
    }
    td.spec {
      grid-column: 2;
      grid-row: 1;
    }
    .ledger tbody tr td:nth-child(3) {
      grid-column: 3;
      grid-row: 1;
      align-self: start;
      padding-top: 0.45rem;
    }
    /* Metadata rows: start where the title starts (column 2) so they
       visually indent under the title rather than under the rownum. */
    .ledger tbody tr td:nth-child(n+4) {
      grid-column: 2 / -1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
    .ledger tbody tr td:nth-child(n+4)::before {
      content: attr(data-label);
      font-family: "IBM Plex Mono", monospace;
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--ink-soft);
      flex: none;
    }
    /* All right-side content lives inside .cell-value (or is a single child
       like a text node or an <a>). The flex parent only sees [label]+[1 item]
       so space-between gives a clean two-column row. */
    .ledger tbody tr td:nth-child(n+4) > .cell-value {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      flex: 0 1 auto;
      text-align: right;
    }
    .spec-title { font-size: 1.4rem; }
    .spec-sub { font-size: 0.82rem; }
    .stage { font-size: 0.86rem; }
  }

  /* Tier: phone — tighter paddings + smaller type for narrow viewports */
  @media (max-width: 640px) {
    .frame { padding: 1.5rem 1rem 2rem; }
    .masthead {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .colophon { text-align: left; margin-top: 0.5rem; }
    h1.title { font-size: clamp(2.2rem, 11vw, 3.2rem); }
    .ledger tbody tr { padding: 1.1rem 0; gap: 0.5rem 0.75rem; }
    .ledger tbody td { font-size: 0.88rem; }
    .ledger tbody tr td:nth-child(n+4)::before { font-size: 0.7rem; letter-spacing: 0.13em; }
    .spec-title { font-size: 1.18rem; }
    .spec-sub { font-size: 0.74rem; }
    .stage { font-size: 0.78rem; }
  }

  /* Tier: very narrow — collapse summary to single column */
  @media (max-width: 420px) {
    .summary { grid-template-columns: 1fr; }
    .stat { border-right: none !important; }
    .stat:not(:last-child) { border-bottom: 1px dotted var(--rule); }
    .stat:last-child { border-bottom: none; }
  }

  /* Short viewport — compress masthead for landscape phones / split panes */
  @media (max-height: 500px) {
    .frame { padding-top: 1.5rem; padding-bottom: 1.5rem; }
    h1.title { font-size: clamp(1.8rem, 4vw, 2.6rem); }
    .stat-num { font-size: 1.6rem; }
    .summary .stat { padding: 0.6rem 1rem; }
  }

  /* Reduced motion — disable row-entry animation */
  @media (prefers-reduced-motion: reduce) {
    .ledger tbody tr { animation: none !important; }
    * { transition: none !important; }
  }
</style>
</head>
<body>
<div class="frame">

  <header class="masthead">
    <div>
      <div class="wordmark">W3C Media Working Group · <span class="accent">Ledger</span></div>
      <h1 class="title">Media<em>WG</em></h1>
    </div>
    <div class="colophon">
      <span class="label">Last refreshed</span>
      <span class="ts">{{ refreshed_iso }}</span>
      <span style="display:block; margin-top:0.4rem;">№ {{ summary.total_specs }} specifications · daily</span>
    </div>
  </header>

  <section class="summary" aria-label="At-a-glance summary">
    <div class="stat">
      <div class="stat-num">{{ summary.total_specs }}</div>
      <div class="stat-label">Specifications</div>
      <div class="stat-extra">{{ summary.by_stage | length }} distinct stages</div>
    </div>
    <div class="stat">
      <div class="stat-num">{{ summary.total_issues }}</div>
      <div class="stat-label">Open issues · all repos</div>
      <div class="stat-extra">across {{ summary.total_specs }} repositories</div>
    </div>
    <div class="stat">
      <div class="stat-num">{{ summary.total_prs }}</div>
      <div class="stat-label">Open pull requests</div>
      <div class="stat-extra">awaiting review &amp; merge</div>
    </div>
    <div class="stat">
      <div class="stat-num">{{ summary.by_stage.keys() | list | length }}</div>
      <div class="stat-label">Stages represented</div>
      <div class="stat-extra">
      {% for stage, n in summary.by_stage.items() %}
        <span class="stage-{{ stage }}"><span class="pip"></span>{{ stage }}&nbsp;{{ n }}</span>{% if not loop.last %} · {% endif %}
      {% endfor %}
      </div>
    </div>
  </section>

  <div class="section-head">
    <span class="section-label">— Status, by specification</span>
    <span class="section-rule"></span>
    <span class="section-meta">{{ summary.shipping_cross_engine }}/{{ summary.total_specs }} shipping cross-engine · click any header to sort · hover a stage code for its definition</span>
  </div>

  <table class="ledger" id="specs">
  <thead>
    <tr>
      <th aria-hidden="true"></th>
      <th>Specification <span class="sort-glyph">⇅</span></th>
      <th>Stage <span class="sort-glyph">⇅</span></th>
      <th>Next <span class="sort-glyph">⇅</span></th>
      <th>Interop</th>
      <th>Pulse</th>
    </tr>
  </thead>
  <tbody>
  {% for row in rows %}
    {% set spec = row.spec %}
    <tr class="spec-row" data-panel="panel-{{ spec.meta.shortname }}">
      <td class="rownum" data-label="№"><span class="caret" aria-hidden="true">▸</span>{{ "%02d" | format(loop.index) }}</td>
      <td class="spec" data-label="Specification">
        {% if spec.status.ed_url %}
          <a class="spec-title" href="{{ spec.status.ed_url }}" onclick="event.stopPropagation()">{{ spec.meta.title }}</a>
        {% else %}
          <span class="spec-title">{{ spec.meta.title }}</span>
        {% endif %}
        <div class="spec-sub">{{ spec.meta.repo }}</div>
      </td>
      <td data-label="Stage">
        <span class="stage {{ spec.status.stage }}" title="{{ stage_descriptions[spec.status.stage] }}">{{ spec.status.stage }}</span>
      </td>
      <td class="gate" data-label="Next gate">
        {% if row.next_gate %}
          <span class="cell-value"><span class="gate-name">→{{ row.next_gate }}</span><span class="hdot gate-dot {{ row.readiness }}" title="{{ row.readiness }}"></span></span>
        {% else %}
          <span class="dash">—</span>
        {% endif %}
      </td>
      <td class="interop" data-label="Interop">
        <span class="cell-value"><span class="interop-dots">{{ row.interop_label }}</span>{% if row.wpt_pct is not none %}<span class="interop-pct">{{ row.wpt_pct | round | int }}%</span>{% endif %}</span>
      </td>
      <td class="pulse" data-label="Pulse">
        {% if row.pulse %}
          <span class="cell-value pulse-{{ row.pulse.tier }}"><span class="hdot pulse-dot"></span><span class="pulse-reason">{{ row.pulse.reason }}</span></span>
        {% else %}
          <span class="dash">—</span>
        {% endif %}
      </td>
    </tr>
    <tr class="panel-row" id="panel-{{ spec.meta.shortname }}" hidden>
      <td colspan="6">
        <div class="panel">
          <div class="panel-group">
            <div class="panel-h">Standardization &amp; next gate</div>
            <dl class="panel-kv">
              <dt>Stage</dt><dd>{{ spec.status.stage }} · in stage {{ row.stage_age_label }}{% if spec.status.last_tr_publication %} · last /TR/ {{ spec.status.last_tr_publication }}{% endif %}</dd>
              <dt>Next gate</dt><dd>{% if row.next_gate %}→ {{ row.next_gate }} <span class="tag tag-{{ row.readiness }}">{{ row.readiness }}</span>{% else %}terminal{% endif %}</dd>
              <dt>Charter</dt><dd>{{ spec.health.charter_target or '—' }}{% if spec.health.charter_overdue %} <span class="tag tag-warn">behind</span>{% endif %}</dd>
            </dl>
            {% if row.blocker_rows %}
            <div class="panel-sub">Blockers to {{ row.next_gate }}</div>
            <ul class="checklist">
              {% for glyph, label, href in row.blocker_rows %}
              <li><span class="chk-mark">{{ glyph }}</span>{% if href %}<a href="{{ href }}">{{ label }}</a>{% else %}{{ label }}{% endif %}</li>
              {% endfor %}
            </ul>
            {% endif %}
            <div class="panel-sub">Horizontal reviews</div>
            <div class="chips">
              {% for name, st, href in row.horizontal_rows %}<a class="chip chip-{{ st }}" href="{{ href }}">{{ name }} {{ st }}</a>{% endfor %}
            </div>
          </div>
          <div class="panel-group">
            <div class="panel-h">Interoperability</div>
            <dl class="panel-kv">
              {% for engine, st, glyph, href in row.engine_rows %}
              <dt>{{ engine }}</dt><dd>{% if href %}<a href="{{ href }}">{{ glyph }} {{ st }}</a>{% else %}{{ glyph }} {{ st }}{% endif %}</dd>
              {% endfor %}
              <dt>All-engines WPT</dt><dd>{% if row.wpt_pct is not none %}{% if row.wpt_href %}<a href="{{ row.wpt_href }}">{{ row.wpt_pct | round | int }}%</a>{% else %}{{ row.wpt_pct | round | int }}%{% endif %}{% else %}—{% endif %}{% if spec.interop.wpt_test_count is not none %} · {{ spec.interop.wpt_test_count }} tests{% endif %}</dd>
              <dt>Interop focus</dt><dd>{{ spec.interop.interop_focus_year or '—' }}</dd>
            </dl>
          </div>
          <div class="panel-group">
            <div class="panel-h">Activity &amp; health</div>
            <dl class="panel-kv">
              <dt>Pulse</dt><dd>{% if row.pulse %}<span class="tag tag-pulse-{{ row.pulse.tier }}">{{ row.pulse.tier }}</span> {{ row.pulse.reason }}{% else %}—{% endif %}</dd>
              <dt>Open issues</dt><dd><a href="https://github.com/{{ spec.meta.repo }}/issues">{{ spec.stats.open_issues_count }}</a>{% if spec.health.backlog_trend %} · {{ spec.health.backlog_trend }}{% endif %}</dd>
              <dt>Open PRs</dt><dd><a href="https://github.com/{{ spec.meta.repo }}/pulls">{{ spec.stats.open_prs_count }}</a></dd>
              <dt>Oldest blocking</dt><dd>{% if spec.health.oldest_blocking_issue_days is not none %}{{ spec.health.oldest_blocking_issue_days }}d{% else %}—{% endif %}</dd>
              <dt>Agenda items</dt><dd>{% if spec.health.agenda_count is not none %}{{ spec.health.agenda_count }}{% else %}—{% endif %}</dd>
              <dt>Editors</dt><dd>{% if spec.health.editor_count is not none %}{{ spec.health.editor_count }}{% else %}—{% endif %}</dd>
            </dl>
            <div class="panel-sub">Links</div>
            <div class="chips">
              <a class="chip" href="https://github.com/{{ spec.meta.repo }}">repo</a>
              {% if spec.meta.tr_url %}<a class="chip" href="{{ spec.meta.tr_url }}">/TR/</a>{% endif %}
              {% if spec.status.ed_url %}<a class="chip" href="{{ spec.status.ed_url }}">ED</a>{% endif %}
              {% if row.wpt_href %}<a class="chip" href="{{ row.wpt_href }}">wpt.fyi</a>{% endif %}
            </div>
          </div>
        </div>
      </td>
    </tr>
  {% else %}
    <tr><td colspan="6" style="text-align:center; color:var(--muted); padding:2rem;">No specifications configured.</td></tr>
  {% endfor %}
  </tbody>
  </table>

  <footer>
    <p>A read-only summary compiled from public sources: <a href="https://api.w3.org/">api.w3.org</a>, <a href="https://api.github.com/">api.github.com</a>, and <a href="https://wpt.fyi/">wpt.fyi</a>. Refreshes once daily via GitHub Actions.</p>
    <p>Source &amp; commit history: <a href="https://github.com/alastor0325/mediawg-dashboard">github.com/alastor0325/mediawg-dashboard</a>.</p>
    <div class="legend">
      <span class="item"><span class="pip green"></span> REC · PR</span>
      <span class="item"><span class="pip blue"></span> CR · CR-snapshot · CR-draft</span>
      <span class="item"><span class="pip amber"></span> WD · FPWD</span>
      <span class="item"><span class="pip mute"></span> ED · NOTE</span>
      <span class="item"><span class="pip rose"></span> Discontinued</span>
    </div>
  </footer>

</div>

<script>
(function () {
  const table = document.getElementById("specs");
  if (!table) return;
  const tbody = table.querySelector("tbody");

  // Expand / collapse the detail panel for a spec row.
  tbody.querySelectorAll("tr.spec-row").forEach(row => {
    row.addEventListener("click", () => {
      const panel = document.getElementById(row.dataset.panel);
      if (!panel) return;
      if (panel.hasAttribute("hidden")) {
        panel.removeAttribute("hidden");
        row.classList.add("open");
      } else {
        panel.setAttribute("hidden", "");
        row.classList.remove("open");
      }
    });
  });

  // Sort by column, keeping each panel row paired directly under its spec row.
  const headers = table.querySelectorAll("thead th");
  headers.forEach((th, idx) => {
    if (th.getAttribute("aria-hidden") === "true") return;
    let asc = true;
    th.addEventListener("click", () => {
      const specRows = Array.from(tbody.querySelectorAll("tr.spec-row"));
      specRows.sort((a, b) => {
        const av = a.cells[idx].textContent.trim();
        const bv = b.cells[idx].textContent.trim();
        const an = parseFloat(av.replace(/,/g, ""));
        const bn = parseFloat(bv.replace(/,/g, ""));
        if (!isNaN(an) && !isNaN(bn)) return asc ? an - bn : bn - an;
        return asc ? av.localeCompare(bv) : bv.localeCompare(av);
      });
      specRows.forEach(r => {
        r.style.animation = "none";
        tbody.appendChild(r);
        const panel = document.getElementById(r.dataset.panel);
        if (panel) tbody.appendChild(panel);
      });
      asc = !asc;
    });
  });
})();
</script>

</body>
</html>
